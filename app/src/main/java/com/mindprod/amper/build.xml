<?xml version="1.0"?>
<!-- BUILD.XML complex amper 2.0 build that copies files to website for upload. -->
<!-- Build with ANT postzip jet -->
<!-- Compile and jar amper using ANT -->
<!-- Invoke with [ant clean] to erase class files and start over. -->
<!-- Invoke with [ant compile] to just compile. -->
<!-- Invoke with [ant jar] to compile and create jar files. -->
<!-- Invoke with [ant postjar] to post jars to the mindprod website. -->
<!-- Invoke with [ant jet] to create JET executables. -->
<!-- Invoke with [ant zip] to create source code zip files. -->
<!-- Invoke with [ant postzip] to post zip file to the mindprod website. -->
<!-- Using Apache ANT version 1.10.1 -->
<!-- For details of ANT use, see http://mindprod.com/jgloss/ant.html -->
<!-- This script does not build any *.asm files. -->

<!-- D E F I N I T I O N S -->
<!-- ANT.project.dir is com/mindprod/amper -->
<!-- basedir is E:/ -->
<project name="amper" basedir="E:/" default="jar">

<!-- extensions for zip. Case sensitive! Go in zip, not necessarily in Jar. -->
<property name="distributed.exts" value="**/*.au,**/*.asm,**/*.bat,**/*.btm,**/*.c,**/*.COM,**/*.com,**/*.cpp,**/*.css,**/*.csv,**/*.dll,**/*.gif,**/*.h,**/*.hpp,**/*.htm,**/*.html,**/*.ico,**/*.ION,**/*.ion,**/*.jar,**/*.java,**/*.jnlp,**/*.JNLP,**/*.jpg,**/*.look,**/*.png,**/*.properties,**/*.ser,**/*.sln,**/*.txt,**/*.use,**/*.xml" />

<!-- dirs we to exclude from zip. Case sensitive! -->
<property name="nondistributed" value="**/javadoc/**,**/jetpdb/**,**/Debug/**,**/Release/**" />

<!-- C L E A N -->
<target name="clean">
<echo message="    :::    amper    :::    deleting files to force regeneration." />
  <delete>
    <fileset dir="com/mindprod/amper" includes="**/*.class" />
    <fileset dir="com/mindprod/amper" includes="**/*.jar" />
    <!-- leave Jet *.exe. Old versions are still useful during the build. -->
    <fileset dir="com/mindprod/amper" includes="amper20.zip" />
  </delete>
</target>

<!-- C O M P I L E -->
<target name="compile">
<echo message="    :::    amper    :::    compiling Java tree with target=1.8" />
  <javac source="1.8" target="1.8" srcdir="com/mindprod/amper" sourcepath="${basedir}" classpath="${basedir}" encoding="UTF-8" debug="on" includeAntRuntime="false">
    <compilerarg value="-Xlint:unchecked" />
    <compilerarg value="-Xlint:fallthrough" />
    <compilerarg value="-Xlint:deprecation" />
    <compilerarg value="-Xlint:cast" />
  </javac>
</target>

<!-- J A V A H must do ant javah to rebuild *.h files. -->
<target name="javah" depends="compile">
  <!-- there is no jni -->
</target>

<!-- G A T H E R -->
<target name="gather" depends="compile">
<echo message="    :::    amper    :::    gathering files to build jar/zip." />
  <!-- prepare amper.use precis from two pieces -->
    <concat destfile="com/mindprod/amper/amper.use" fixlastline="yes">
      <filelist dir="com/mindprod/amper" files="version.txt,use.txt,versionhistory.txt" />
    </concat>
    <copy file="E:/mindprod/application/amper.html" todir="com/mindprod/amper" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/application/amper.manual.html" todir="com/mindprod/amper" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/image/ico/amper.ico" tofile="E:/mindprod/application/amper.ico" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/image/icon128/amper.png" tofile="com/mindprod/amper/amper.icon128.png" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/image/icon16/amper.png" tofile="com/mindprod/amper/amper.icon16.png" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/image/icon32/amper.png" tofile="com/mindprod/amper/amper.icon32.png" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/image/icon48/amper.png" tofile="com/mindprod/amper/amper.icon48.png" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/image/icon64/amper.png" tofile="com/mindprod/amper/amper.icon64.png" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/image/screenshot/amper.png" tofile="com/mindprod/amper/amper.screenshot.png" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/jdisplay.css" todir="com/mindprod/amper" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/mindprod.css" todir="com/mindprod/amper" failonerror="false" quiet="true" overwrite="true" />
    <copy file="E:/mindprod/pad/amper.xml" todir="com/mindprod/amper" failonerror="false" quiet="true" overwrite="true" />
</target>

<!-- J A R -->
<!-- Make F:\Program Files (x86)\apache-ant-1.10.1\lib\GenJar.jar known to ANT -->
<!-- See http://mindprod.com/jgloss/genjar.html for details -->
<taskdef resource="genjar.properties" />

<target name="jar" depends="gather">
<echo message="    :::    amper    :::    genjar finding dependencies and creating jar." />
  <genjar jarfile="com/mindprod/amper/amper.jar">
    <!-- include main class and all its dependencies -->
    <class name="com.mindprod.amper.Amper" />
    <!-- define the manifest -->
    <manifest>
      <attribute name="Main-Class" value="com.mindprod.amper.Amper" />
      <attribute name="Application-Name" value="Amper" />
    </manifest>
  </genjar>

  <!-- J A R C H E C K -->
  <exec executable="jarcheck.exe" dir="com/mindprod/amper" output="nul:" logError="true" failonerror="true">
    <arg value="amper.jar" />
    <arg value="1.2" />
    <arg value="1.8" />
  </exec>
  <!-- J A R L O O K -->
  <exec executable="jarlook.exe" dir="com/mindprod/amper" output="com/mindprod/amper/amper.look">
    <arg value="amper.jar" />
  </exec>
  <!-- build deampify.jar -->
  <genjar jarfile="com/mindprod/amper/deampify.jar">
    <class name="com.mindprod.amper.DeAmpify" />
    <!-- define the manifest -->
    <manifest>
      <attribute name="Main-Class" value="com.mindprod.amper.DeAmpify" />
      <attribute name="Application-Name" value="DeAmpify" />
    </manifest>
  </genjar>

  <!-- J A R C H E C K -->
  <exec executable="jarcheck.exe" dir="com/mindprod/amper" output="nul:" logError="true" failonerror="true">
    <arg value="deampify.jar" />
    <arg value="1.1" />
    <arg value="1.8" />
  </exec>
  <!-- J A R L O O K -->
  <exec executable="jarlook.exe" dir="com/mindprod/amper" output="com/mindprod/amper/deampify.look">
    <arg value="deampify.jar" />
  </exec>
</target>

<!-- P O S T J A R -->
<target name="postjar" depends="jar">
  <!-- nothing to do -->
</target>

<!-- P R E J E T -->
<target name="prejet">
<echo message="    :::    amper    :::    avoid regenerating Jet executable if already done." />
  <uptodate property="jet.uptodate" targetfile="com/mindprod/amper/amper.exe">
    <srcfiles dir="com/mindprod/amper" includes="*.jar"/>
    </uptodate>
</target>

<!-- J E T -->
<!-- Requires Excelsior JET native Java compiler jc.exe on the path -->
<!-- See http://mindprod.com/jgloss/jet.html for details -->
<target name="jet" depends="prejet" unless="jet.uptodate">
<echo message="    :::    amper    :::    jet compiling." />
  <exec executable="jc.exe" dir="com/mindprod/amper">
    <arg value="-DECOR=" />
    <arg value="amper.jar" />
  </exec>
  <!-- copy amper.exe to E:/sys -->
  <copy file="com/mindprod/amper/amper.exe" todir="E:/sys" />
  <echo message="    :::    amper/DeAmpify    :::    jet compiling" />
  <exec executable="jc.exe" dir="com/mindprod/amper">
    <arg value="-DECOR=" />
    <arg value="deampify.jar" />
  </exec>
  <!-- copy deampify.exe to E:/sys -->
  <copy file="com/mindprod/amper/deampify.exe" todir="E:/sys" />
</target>

<!-- Z I P -->
<target name="zip" depends="jar">
<echo message="    :::    amper    :::    preparing zip distributable." />
  <!-- Remove references to separate foot files. -->
  <exec executable="prunefoot.exe" failifexecutionfails="false" dir="com/mindprod/amper">
    <arg value="amper.html" />
    <arg value="amper.manual.html" />
  </exec>
  <zip destfile="com/mindprod/amper/amper20.zip" duplicate="preserve" filesonly="true" includes="${distributed.exts}" excludes="${nondistributed}">
    <!-- zipfileset includes all subdirs as well -->
    <zipfileset dir="com/mindprod/amper" prefix="com/mindprod/amper" includes="${distributed.exts}" excludes="${nondistributed}" />
    <!-- Extra classes and properties to include in the Zip -->
      <zipfileset dir="com/mindprod/commandline" prefix="com/mindprod/commandline" includes="${distributed.exts}" excludes="${nondistributed}" />
      <zipfileset dir="com/mindprod/common18"    prefix="com/mindprod/common18"    includes="${distributed.exts}" excludes="${nondistributed}" />
      <zipfileset dir="com/mindprod/fastcat"     prefix="com/mindprod/fastcat"     includes="${distributed.exts}" excludes="${nondistributed}" />
      <zipfileset dir="com/mindprod/filter" prefix="com/mindprod/filter" includes="${distributed.exts}" excludes="${nondistributed}" />
      <zipfileset dir="com/mindprod/hunkio" prefix="com/mindprod/hunkio" includes="${distributed.exts}" excludes="${nondistributed}" />
  </zip>

  <!-- Z I P L O O K -->
  <exec executable="jarlook.exe" dir="com/mindprod/amper" output="com/mindprod/amper/zip.look">
    <arg value="amper20.zip" />
  </exec>
</target>

<!-- P O S T Z I P -->
<target name="postzip" depends="zip,postjar">
<echo message="    :::    amper    :::    posting zip to website." />
  <!-- copy precis to website -->
  <copy file="com/mindprod/amper/amper.use" tofile="E:/mindprod/precis/amper.txt" overwrite="true" />
  <!-- copy com\mindprod\amper/amper20.zip to website -->
  <copy file="com\mindprod\amper/amper20.zip" todir="E:/mindprod/zips" overwrite="true" />
  <!-- delete old zip distributable from project and website -->
  <delete file="com/mindprod/amper/amper19.zip" failonerror="false" quiet="true" />
  <delete file="E:/mindprod/zips/amper19.zip" failonerror="false" quiet="true" />
</target>
</project>
